{
  "name": "mail-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "prestart": "bun run build",
    "start": "bun run build/index.js",
    "build": "bun build src/index.ts --outdir ./build --target=node",
    "dev:email": "email dev",
    "export": "email export",
    "worker": "bun src/workers/index.ts",
    "worker:2": "bun src/workers/worker-2.ts"
  },
  "dependencies": {
    "@react-email/render": "^2.0.8",
    "bullmq": "^5.10.5",
    "dotenv": "^17.4.2",
    "hono": "^4.7.0",
    "nodemailer": "^6.9.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.1.5",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.1.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "^4.22.2",
    "typescript": "^5"
  }
}